# Copy this file to .env and adjust values as needed.
# .env is git-ignored and should never be committed.

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# --- Database ---
# DB_ENGINE=sqlite uses a local db.sqlite3 file (no setup required).
# DB_ENGINE=postgresql uses the DB_* settings below (matches docker-compose).
DB_ENGINE=sqlite
DB_NAME=aiops_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Channels / Redis (real-time notifications) ---
# CHANNEL_LAYER_BACKEND=inmemory works out of the box for local dev/tests.
# CHANNEL_LAYER_BACKEND=redis requires Redis (see docker-compose.yml).
CHANNEL_LAYER_BACKEND=inmemory
REDIS_HOST=localhost
REDIS_PORT=6379
